# Copy this file to ".env" to enable a real AI model. Without it, AI ARENA runs in Demo mode.
# The key stays on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
MODEL_TIMEOUT_MS=30000
# Hard ceiling for one round, in milliseconds (games are meant to last under a minute).
ROUND_DEADLINE_MS=60000
PORT=3001
