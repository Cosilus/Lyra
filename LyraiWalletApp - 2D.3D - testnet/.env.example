# Copy this file to .env and fill in real values. Never commit .env.

# --- AI engine (intent classification, /api/ai) ---
# OpenRouter (Qwen) is the primary engine. Groq and Cerebras are free,
# dedicated fast-inference providers (open models like Llama 3.3 70B),
# wired in as the next fallbacks so a paid/rate-limited provider going
# down doesn't drag every request down to Mistral/Gemini/Claude. Then
# Mistral, then Gemini. Fill in any subset — one key alone is enough to
# keep the assistant working.
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen-2.5-7b-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Deep research agent (ASK_CRYPTO, DeFi ticket preparation) ---
# Uses the real Anthropic API (Claude with web search). Leave empty to
# disable — the app will say deep research isn't configured yet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Block explorer (transaction history, contract verification) ---
ETHERSCAN_API_KEY=

# --- Onramper (real fiat <-> crypto, RECEIVE_FIAT / OFFRAMP_FUNDS) ---
# Get both from your Onramper dashboard (dashboard.onramper.com).
# Leave empty and Lyra falls back to a demo-only simulation for
# RECEIVE_FIAT (and tells the user cash-out isn't available yet for
# OFFRAMP_FUNDS) -- see server/tools/onramper.js.
ONRAMPER_API_KEY=
# The Ed25519 private key (PEM) used to sign widget URLs server-side.
# Paste it on one line with literal "\n" in place of real newlines,
# e.g. -----BEGIN PRIVATE KEY-----\nMC4CAQ...\n-----END PRIVATE KEY-----
ONRAMPER_PRIVATE_KEY_PEM=

# --- Optional paid RPC overrides (used by both client and server) ---
# Leave empty to fall back to each network's free public RPC.
VITE_ETH_RPC_URL=
VITE_BASE_RPC_URL=
VITE_POLYGON_RPC_URL=

# --- Server ---
# Render provides PORT automatically — only needed for local overrides.
PORT=3001

# Comma-separated list of allowed frontend origins in production, e.g.:
# CORS_ORIGIN=https://lyra-wallet.vercel.app,https://lyra.app
# Leave empty to allow all origins (fine for local dev).
CORS_ORIGIN=

# Public URL of this backend once deployed (used only as the
# HTTP-Referer header sent to OpenRouter — cosmetic, not required).
APP_URL=

# --- MPC (2-of-2 key-split) ---
# 32-byte hex key (64 hex chars) encrypting fragment2 at rest. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty in local dev and the server generates a throwaway one at
# startup (logged as a warning) -- fine for testing, but every restart
# invalidates any fragment2 already stored under it. Set a real,
# persistent value before this holds a wallet you care about. In production
# the server refuses to start without it. Keep a backup copy: losing it makes
# every stored protected key unreadable.
MPC_MASTER_KEY=
# Where protected keys are stored. Production: set DATABASE_URL to a
# PostgreSQL connection string (Neon works on its free plan, no disk needed).
# Left empty, a JSON file is used (local dev only): server/mpc/mpc-store.json,
# or MPC_DB_PATH if you have a persistent disk.
DATABASE_URL=
MPC_DB_PATH=

# Which AI provider answers the chat FIRST (openrouter | mistral | gemini | claude).
# Unset = default order (OpenRouter, Mistral, Gemini, Claude). Others stay as fallbacks.
# AI_PRIMARY=claude
