# Copy this file to .env and fill in real values. Never commit .env.

# --- AI engine (intent classification, /api/ai) ---
# OpenRouter (Qwen) is the primary engine. Mistral is an automatic
# fallback: if OpenRouter fails or its key is missing, the same
# request is retried on Mistral. Fill in either or both — one alone
# is enough to keep the assistant working.
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Deep research agent (ASK_CRYPTO, DeFi ticket preparation) ---
# Uses the real Anthropic API (Claude with web search). Leave empty to
# disable — the app will say deep research isn't configured yet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Block explorer (transaction history, contract verification) ---
ETHERSCAN_API_KEY=

# --- Optional paid RPC overrides (used by both client and server) ---
# Leave empty to fall back to each network's free public RPC.
VITE_ETH_RPC_URL=
VITE_BASE_RPC_URL=
VITE_POLYGON_RPC_URL=

# --- Server ---
# Render provides PORT automatically — only needed for local overrides.
PORT=3001

# Comma-separated list of allowed frontend origins in production, e.g.:
# CORS_ORIGIN=https://lyra-wallet.vercel.app,https://lyra.app
# Leave empty to allow all origins (fine for local dev).
CORS_ORIGIN=

# Public URL of this backend once deployed (used only as the
# HTTP-Referer header sent to OpenRouter — cosmetic, not required).
APP_URL=

# --- MPC (2-of-2 key-split) ---
# 32-byte hex key (64 hex chars) encrypting fragment2 at rest. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty in local dev and the server generates a throwaway one at
# --- Safe Transaction Service key (multisig), SERVER ONLY ---
# Read by server/routes/safe.js, never sent to the browser: no VITE_ prefix,
# or it would end up in the public JS bundle. Works without it, but
# unauthenticated calls are limited to 2 requests/s and 5,000/month.
# Free key: https://developer.safe.global
SAFE_API_KEY=

# startup (logged as a warning) -- fine for testing, but every restart
# invalidates any fragment2 already stored under it. Set a real,
# persistent value before this holds a wallet you care about.
MPC_MASTER_KEY=
# Where the prototype JSON store lives. Defaults to server/mpc/mpc-store.json.
MPC_DB_PATH=

# Which AI provider answers the chat FIRST (openrouter | mistral | gemini | claude).
# Unset = default order (OpenRouter, Mistral, Gemini, Claude). Others stay as fallbacks.
# AI_PRIMARY=claude
