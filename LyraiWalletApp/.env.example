# Copy this file to .env and fill in real values. Never commit .env.

# --- AI engine (intent classification, /api/ai) ---
# OpenRouter (Qwen) is the primary engine. Mistral is an automatic
# fallback: if OpenRouter fails or its key is missing, the same
# request is retried on Mistral. Fill in either or both — one alone
# is enough to keep the assistant working.
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Deep research agent (ASK_CRYPTO, DeFi ticket preparation) ---
# Uses the real Anthropic API (Claude with web search). Leave empty to
# disable — the app will say deep research isn't configured yet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Block explorer (transaction history, contract verification) ---
ETHERSCAN_API_KEY=

# --- Server ---
# Render provides PORT automatically — only needed for local overrides.
PORT=3001

# Comma-separated list of allowed frontend origins in production, e.g.:
# CORS_ORIGIN=https://lyra-wallet.vercel.app,https://lyra.app
# Leave empty to allow all origins (fine for local dev).
CORS_ORIGIN=

# Public URL of this backend once deployed (used only as the
# HTTP-Referer header sent to OpenRouter — cosmetic, not required).
APP_URL=
