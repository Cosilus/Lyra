# Polygon EOA private key that controls your Polymarket account.
# NEVER commit the real .env file. This key can move real funds.
PRIVATE_KEY=0xyour_private_key_here

# Polygon RPC endpoint (any public or dedicated provider works).
RPC_URL=https://polygon-rpc.com

# If your OS DNS can't resolve polymarket.com domains (ISP-level hijack,
# seen on some dev machines), set this to a working resolver (e.g. 1.1.1.1)
# and the bot will use it just for Polymarket API lookups.
# DEV_DNS_OVERRIDE=1.1.1.1

# Safety switch: real orders are NEVER placed unless this is exactly "true".
# Leave it unset/false while you validate the bot with --dry-run.
LIVE_TRADING=false

# --- Strategy tuning -------------------------------------------------------

# Fraction of the window (0-1) before close during which the bot is allowed
# to enter. 0.9 = only in the last 10% of the 5-minute window (~last 30s).
ENTRY_WINDOW_FRACTION=0.9

# Minimum |price move| since the window opened, as a fraction (0.0006 = 0.06%),
# required before the bot considers the direction "decided enough" to bet.
MIN_MOVE_THRESHOLD=0.0006

# Skip the trade if the market's own implied price for the chosen side is
# already above this (no edge left, and above this Polymarket's FOK price
# often can't fill anyway).
MAX_ENTRY_PRICE=0.93

# Skip the trade if the market's implied price for the chosen side is below
# this (means the book disagrees hard with our read, likely broken data
# rather than an actual edge).
MIN_ENTRY_PRICE=0.55

# --- Risk management --------------------------------------------------------

# USD stake per trade.
STAKE_USD=2

# Stop trading for the day once realized losses reach this many USD.
MAX_DAILY_LOSS_USD=20

# Stop trading for the day once realized profit reaches this many USD
# (lock in gains instead of giving them back).
MAX_DAILY_PROFIT_USD=40

# Pause for MAX_CONSECUTIVE_LOSS_COOLDOWN_MIN minutes after this many
# losing trades in a row.
MAX_CONSECUTIVE_LOSSES=4
CONSECUTIVE_LOSS_COOLDOWN_MIN=30

# Hard cap on trades per day, independent of P&L (keeps gas/fee bleed and
# blast radius bounded even if the strategy is quietly broken).
MAX_TRADES_PER_DAY=60
