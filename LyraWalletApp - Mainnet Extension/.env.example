# Backend the extension talks to: the MAINNET backend (LyraiWalletApp - 2D.3D,
# "npm run server", port 3001). Baked in at build time. For the Store build,
# the public https:// address of the deployed mainnet backend.
VITE_API_URL=http://localhost:3001
# Optional: your own RPC endpoints (otherwise the public ones in src/config.js)
VITE_ETH_RPC_URL=
VITE_BASE_RPC_URL=
VITE_POLYGON_RPC_URL=
